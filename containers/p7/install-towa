#!/bin/sh
# Install the towa harness at the pinned version into the directory given.
# This image's build and protocol7-selfdev's both run it, so the version is
# pinned in one place.
set -eu

version=0.1.2
sha256=1c2a239c12b43ac9190094a1d42f18b699bbcbfe7483100f0b2149245a058940

destination=$1
cd "$(mktemp -d)"
curl -fsSL -o towa.tgz "https://github.com/gfx-labs/towa/releases/download/v${version}/towa_${version}_linux_amd64.tar.gz"
echo "${sha256}  towa.tgz" | sha256sum -c -
tar -xzf towa.tgz
install -D -m 0755 "towa_${version}_linux_amd64/towa" "${destination}/towa"
